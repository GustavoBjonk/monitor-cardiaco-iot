    [ "pot1:VCC", "esp:3V3", "red", [] ],
    [ "pot1:SIG", "esp:34", "orange", [] ],
    [ "sw1:1", "esp:GND.1", "black", [] ],
    [ "sw1:2", "esp:27", "violet", [] ],
    [ "bz1:1", "esp:GND.3", "black", [] ],
    [ "bz1:2", "esp:25", "yellow", [] ],
    [ "led1:A", "esp:26", "red", [] ],
    [ "led1:C", "r1:1", "black", [] ],
    [ "r1:2", "esp:GND.3", "black", [] ]
