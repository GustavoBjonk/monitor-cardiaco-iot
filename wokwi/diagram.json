{
  "version": 1,
  "author": "Monitor Cardiaco IoT - UPM",
  "editor": "wokwi",
  "parts": [
    { "type": "board-esp32-devkit-c-v4", "id": "esp", "top": 0, "left": 0, "attrs": {} },
    { "type": "board-ssd1306", "id": "oled1", "top": -112, "left": 163, "attrs": { "i2cAddress": "0x3c" } },
    { "type": "wokwi-potentiometer", "id": "pot1", "top": 30, "left": -190, "attrs": {} },
    { "type": "wokwi-slide-switch", "id": "sw1", "top": 160, "left": -150, "attrs": { "value": "1" } },
    { "type": "wokwi-buzzer", "id": "bz1", "top": 170, "left": 230, "attrs": { "volume": "0.2" } },
